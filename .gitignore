node_modules/
dist/
*.local
.DS_Store
exports/*
!exports/.gitkeep

# Build cruft that should never be committed again
*.zip
# Vite writes these next to the config when it loads a TS config, and does not
# always clean them up if the dev server dies mid-start.
vite.config.ts.timestamp-*
vite.config.ts.timestamp-*.mjs

# Regenerated by brand/build.py; the committed assets are in public/ and ios/.
brand/preview-*.png
